{
  "expo": {
    "name": "FlowSpeak",
    "slug": "flowspeak-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "FlowSpeak needs your microphone to record and evaluate your English speech."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0d1a",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "FlowSpeak needs your microphone to evaluate your English speech."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
