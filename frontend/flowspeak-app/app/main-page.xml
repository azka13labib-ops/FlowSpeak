<!-- 
  FlowSpeak — app/main-page.xml
  The single page view — Neobrutalism + Glassmorphism UI.
  Binding context: MainViewModel (main-view-model.ts)
-->
<Page
  xmlns="http://schemas.nativescript.org/tns.xsd"
  class="page"
  loaded="onPageLoaded"
  statusBarStyle="light"
  androidStatusBarBackground="#0d0d1a">

  <Page.actionBar>
    <ActionBar title="🎙 FlowSpeak" flat="true" color="#f8fafc" backgroundColor="#0d0d1a">
      <ActionBar.titleView>
        <StackLayout orientation="horizontal" verticalAlignment="center">
          <Label text="Flow" fontSize="20" fontWeight="900" color="#7c3aed"/>
          <Label text="Speak" fontSize="20" fontWeight="900" color="#06b6d4"/>
        </StackLayout>
      </ActionBar.titleView>
    </ActionBar>
  </Page.actionBar>

  <!-- Root scroll so content is accessible on small screens -->
  <ScrollView>
    <StackLayout>

      <!-- ── Speaking Prompt Card ─────────────────────────────────────────── -->
      <StackLayout class="prompt-card">
        <Label text="TODAY'S TOPIC" class="prompt-label"/>
        <Label
          text="Tell me about a skill you've been trying to learn and why it matters to you."
          class="prompt-text"
          textWrap="true"/>
      </StackLayout>

      <!-- ── Record Button ──────────────────────────────────────────────────── -->
      <StackLayout horizontalAlignment="center" marginBottom="8">
        <!-- Animated ring behind the button when recording -->
        <StackLayout
          visibility="{{ isRecording ? 'visible' : 'collapsed' }}"
          width="240" height="240"
          borderRadius="120"
          borderWidth="3"
          borderColor="#ef444440"
          horizontalAlignment="center"
          verticalAlignment="center"
          marginBottom="-240">
        </StackLayout>

        <Button
          text="{{ buttonLabel }}"
          tap="onRecordTap"
          class="{{ buttonClass }}"
          isEnabled="{{ !isProcessing }}"/>
      </StackLayout>

      <!-- Processing indicator (while uploading audio) -->
      <StackLayout
        visibility="{{ isProcessing ? 'visible' : 'collapsed' }}"
        horizontalAlignment="center"
        marginBottom="16">
        <ActivityIndicator busy="true" color="#7c3aed" width="32" height="32"/>
        <Label text="Sending audio to Whisper..." fontSize="13" color="#94a3b8" textAlignment="center" marginTop="6"/>
      </StackLayout>

      <!-- ── Transcript Card ────────────────────────────────────────────────── -->
      <StackLayout
        class="glass-card"
        visibility="{{ transcript || isProcessing ? 'visible' : 'collapsed' }}">

        <Label text="TRANSCRIPT" class="section-title"/>
        <StackLayout class="divider"/>

        <Label
          text="{{ transcript }}"
          class="transcript-text"
          textWrap="true"
          visibility="{{ transcript ? 'visible' : 'collapsed' }}"/>

        <!-- AI analyzing pill — shown after transcript arrives, during evaluation -->
        <StackLayout
          class="analyzing-pill"
          orientation="horizontal"
          visibility="{{ isAnalyzing ? 'visible' : 'collapsed' }}">
          <ActivityIndicator busy="true" color="#06b6d4" width="16" height="16" marginRight="8"/>
          <Label text="AI is analyzing grammar..." class="analyzing-text" verticalAlignment="middle"/>
        </StackLayout>

      </StackLayout>

      <!-- ── Results Slide-Up Card ──────────────────────────────────────────── -->
      <StackLayout
        visibility="{{ showResults ? 'visible' : 'collapsed' }}"
        class="glass-card">

        <!-- Overall Score Badge -->
        <StackLayout class="overall-badge">
          <Label text="{{ scoreOverall }}" class="overall-text" textAlignment="center"/>
          <Label text="OVERALL SCORE" class="overall-label"/>
        </StackLayout>

        <!-- ── Score Bars Section ──────────────────────────────────────────── -->
        <Label text="BREAKDOWN" class="section-title"/>
        <StackLayout class="divider"/>

        <!-- Fluency -->
        <GridLayout columns="auto, *, auto" marginBottom="12">
          <Label col="0" text="Fluency" fontSize="13" color="#f8fafc" verticalAlignment="middle"/>
          <StackLayout col="1" class="progress-track" marginLeft="12" marginRight="12" verticalAlignment="middle">
            <StackLayout
              class="progress-fill-fluency"
              height="8"
              borderRadius="4"
              width="{{ scoreFluency + '%' }}"
              horizontalAlignment="left"/>
          </StackLayout>
          <Label col="2" text="{{ scoreFluency }}" fontSize="13" fontWeight="700" color="#06b6d4"/>
        </GridLayout>

        <!-- Grammar -->
        <GridLayout columns="auto, *, auto" marginBottom="12">
          <Label col="0" text="Grammar" fontSize="13" color="#f8fafc" verticalAlignment="middle"/>
          <StackLayout col="1" class="progress-track" marginLeft="12" marginRight="12" verticalAlignment="middle">
            <StackLayout
              class="progress-fill-grammar"
              height="8"
              borderRadius="4"
              width="{{ scoreGrammar + '%' }}"
              horizontalAlignment="left"/>
          </StackLayout>
          <Label col="2" text="{{ scoreGrammar }}" fontSize="13" fontWeight="700" color="#7c3aed"/>
        </GridLayout>

        <!-- Vocabulary -->
        <GridLayout columns="auto, *, auto" marginBottom="16">
          <Label col="0" text="Vocabulary" fontSize="13" color="#f8fafc" verticalAlignment="middle"/>
          <StackLayout col="1" class="progress-track" marginLeft="12" marginRight="12" verticalAlignment="middle">
            <StackLayout
              class="progress-fill-vocabulary"
              height="8"
              borderRadius="4"
              width="{{ scoreVocabulary + '%' }}"
              horizontalAlignment="left"/>
          </StackLayout>
          <Label col="2" text="{{ scoreVocabulary }}" fontSize="13" fontWeight="700" color="#10b981"/>
        </GridLayout>

        <!-- ── Corrections Section ─────────────────────────────────────────── -->
        <Label
          text="CORRECTIONS"
          class="section-title"
          visibility="{{ corrections.length > 0 ? 'visible' : 'collapsed' }}"/>
        <StackLayout
          class="divider"
          visibility="{{ corrections.length > 0 ? 'visible' : 'collapsed' }}"/>

        <Repeater items="{{ corrections }}" visibility="{{ corrections.length > 0 ? 'visible' : 'collapsed' }}">
          <Repeater.itemTemplate>
            <StackLayout class="correction-card">
              <Label text="{{ original }}" class="correction-original" textWrap="true"/>
              <Label text="↓" class="correction-arrow" textAlignment="center"/>
              <Label text="{{ fixed }}" class="correction-fixed" textWrap="true"/>
              <Label text="{{ explanation }}" class="correction-explanation" textWrap="true"/>
            </StackLayout>
          </Repeater.itemTemplate>
        </Repeater>

        <!-- No corrections message -->
        <Label
          text="✅ No corrections — great job!"
          visibility="{{ corrections.length === 0 ? 'visible' : 'collapsed' }}"
          fontSize="14"
          color="#6ee7b7"
          textAlignment="center"
          marginBottom="12"/>

        <!-- ── Vocabulary Tips Section ─────────────────────────────────────── -->
        <Label
          text="VOCABULARY TIPS"
          class="section-title"
          visibility="{{ vocabTips.length > 0 ? 'visible' : 'collapsed' }}"
          marginTop="8"/>
        <StackLayout
          class="divider"
          visibility="{{ vocabTips.length > 0 ? 'visible' : 'collapsed' }}"/>

        <Repeater items="{{ vocabTips }}" visibility="{{ vocabTips.length > 0 ? 'visible' : 'collapsed' }}">
          <Repeater.itemTemplate>
            <Label text="{{ $value }}" class="vocab-tip" textWrap="true"/>
          </Repeater.itemTemplate>
        </Repeater>

      </StackLayout>

      <!-- Bottom padding -->
      <StackLayout height="32"/>

    </StackLayout>
  </ScrollView>

</Page>
